---
import "../styles/global.css"

interface Props {
  title: string
  description: string
  ogImage?: string
  canonicalPath?: string
  ogType?: string
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
}

const {
  title,
  description,
  ogImage = "/og-atmosphere.png",
  canonicalPath = Astro.url.pathname.replace(/\/$/, "") || "/",
  ogType = "website",
  jsonLd,
} = Astro.props

const site = "https://www.anointedstaff.com"
const canonical = new URL(canonicalPath === "/" ? "/" : canonicalPath, site).href
const og = new URL(ogImage, site).href
const github = "https://github.com/quantumfiduciary/anointedstaff"
const releases = `${github}/releases`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:site_name" content="Anointed Staff" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <link rel="icon" href="/brand-mark.png" type="image/png" />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap inner">
        <a class="brand-lockup" href="/">
          <img class="brand-mark" src="/brand-mark.png" alt="" width="36" height="36" />
          <img
            class="brand-wordmark-nav"
            src="/brand/wordmark-clean-cream.png"
            alt="Anointed Staff"
            width="180"
            height="48"
          />
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href="/#catalog">Features</a>
          <a href="/#fence">Fence</a>
          <a href="/blog">Blog</a>
          <a href={github}>GitHub</a>
          <a class="btn btn-primary" href={releases}>Download</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap inner">
        <p>
          Anointed Staff is a local-first Scripture desk — lamp-lit study beside the Word,
          not a cloud account that keeps you. Marketing on Cloudflare Pages; the study runtime
          ships from Releases and the monorepo.
        </p>
        <p>
          Code: Apache-2.0. Texts and media: see NOTICE. Hermetic shelves are historical study,
          not ritual. Heavens stay clocks beside Scripture — not fortunes.
        </p>
        <p class="footer-links">
          <a href="/blog">Blog</a>
          <a href={releases}>Download for Windows</a>
          <a href={github}>GitHub</a>
          <a href="/#faq">FAQ</a>
        </p>
      </div>
    </footer>
  </body>
</html>
