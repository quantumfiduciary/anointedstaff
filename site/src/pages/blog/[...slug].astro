---
import { getCollection, type CollectionEntry } from "astro:content"
import BaseLayout from "../../layouts/BaseLayout.astro"

export async function getStaticPaths() {
  const posts = await getCollection("blog")
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

interface Props {
  post: CollectionEntry<"blog">
}

const { post } = Astro.props
const { Content } = await post.render()
const path = `/blog/${post.slug}`
---

<BaseLayout
  title={`${post.data.title} · Anointed Staff`}
  description={post.data.description}
  ogImage={post.data.heroImage || "/screenshots/desk-bible.png"}
  canonicalPath={path}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    image: post.data.heroImage
      ? `https://anointedstaff.com${post.data.heroImage}`
      : undefined,
    author: { "@type": "Organization", name: "Anointed Staff" },
    mainEntityOfPage: `https://anointedstaff.com${path}`,
  }}
>
  <article class="wrap prose">
    <h1>{post.data.title}</h1>
    <p class="meta">
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
      </time>
    </p>
    {
      post.data.heroImage && (
        <img
          src={post.data.heroImage}
          alt=""
          width="1600"
          height="1000"
          loading="eager"
        />
      )
    }
    <Content />
  </article>
</BaseLayout>
