---
import { getCollection, type CollectionEntry } from "astro:content"
import BaseLayout from "../../layouts/BaseLayout.astro"

export async function getStaticPaths() {
  const posts = await getCollection("blog")
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

interface Props {
  post: CollectionEntry<"blog">
}

const { post } = Astro.props
const { Content } = await post.render()
const path = `/blog/${post.slug}`
const site = "https://www.anointedstaff.com"
const hero = post.data.heroImage
  ? `${site}${post.data.heroImage}`
  : `${site}/og-atmosphere.png`

const title = `${post.data.title} · Anointed Staff`
const description = post.data.description

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description,
    datePublished: post.data.pubDate.toISOString(),
    image: hero,
    author: { "@type": "Organization", name: "Anointed Staff", url: site },
    publisher: {
      "@type": "Organization",
      name: "Anointed Staff",
      logo: { "@type": "ImageObject", url: `${site}/brand-mark.png` },
    },
    mainEntityOfPage: { "@type": "WebPage", "@id": `${site}${path}` },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: site,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Blog",
        item: `${site}/blog`,
      },
      {
        "@type": "ListItem",
        position: 3,
        name: post.data.title,
        item: `${site}${path}`,
      },
    ],
  },
]
---

<BaseLayout
  title={title}
  description={description}
  ogImage={post.data.heroImage || "/og-atmosphere.png"}
  ogType="article"
  canonicalPath={path}
  jsonLd={jsonLd}
>
  <article class="wrap prose">
    <h1>{post.data.title}</h1>
    <p class="meta">
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
      </time>
      · <a href="/blog">All notes</a> · <a href="/">Home</a>
    </p>
    {
      post.data.heroImage && (
        <img
          src={post.data.heroImage}
          alt=""
          width="1600"
          height="1000"
          loading="eager"
        />
      )
    }
    <Content />
  </article>
</BaseLayout>
