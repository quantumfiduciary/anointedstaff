---
import BaseLayout from "../layouts/BaseLayout.astro"
import { downloads, github, releasePage, releases } from "../data/downloads"

const title = "Anointed Staff — Local Scripture Study Desk"
const description =
  "A lamp-lit local desk for Scripture beside Strong’s, Extra-canon, Heavens clocks, Notes, Gematria, and optional AI. Public-domain texts. Notes and keys stay on your machine."

const features = [
  {
    title: "Bible · Books",
    body: "Public-domain witnesses on the rail. Chapter stays the center while Books and search move you through the canon.",
  },
  {
    title: "Strong’s",
    body: "Look up a number, walk This verse, Paleo notes, Hear, and Ask about this word beside the open line.",
  },
  {
    title: "Roots",
    body: "Strong’s chains, Hitchcock names, and English trees so language study stays next to the chapter.",
  },
  {
    title: "Notes · Wiki · Kanban",
    body: "Highlights, journals, wiki pages, cards, table, board, and Kanban lanes from To study to Applied — notes stay on this device.",
  },
  {
    title: "AI beside the chapter",
    body: "Optional local or cloud model with study chips (Explain, Strong’s, Extra-canon, Heavens…). Keys default to session-only.",
  },
  {
    title: "Voice",
    body: "Hands-free study window and chapter Listen with voices installed on your machine.",
  },
  {
    title: "Extra-canon shelf",
    body: "Public-domain books beside the sixty-six — Enoch, Sophia, Gospels.net, Fathers, Hermetic history — credited and labeled.",
  },
  {
    title: "Gematria · letters",
    body: "Learn the alef-bet, mothers/doubles/simples, count a word, Hear clips, and drills that link back to Strong’s and Scripture.",
  },
  {
    title: "Heavens",
    body: "Cast a chart, Witness path, Decans, Circle, Camp, Job 38, Psalm 19 — clocks and glory beside Scripture, not fortunes.",
  },
  {
    title: "Practice",
    body: "Temple walk, Drill, Cards, Meditate, Quiet music, and offline Hebrew Hear — stillness baked into the build.",
  },
  {
    title: "Compare · Listen",
    body: "Second PD witnesses (including non-English packs) and read-aloud for the open chapter.",
  },
  {
    title: "Five appearances",
    body: "Light, Dark, Mystic, Parchment, and Ink share Staff Gold — Outfit, Fraunces, Literata, and Noto across the desk.",
  },
]

const faqItems = [
  {
    q: "Is this a cloud Bible app?",
    a: "No. Anointed Staff is local-first. The marketing site educates; the study runtime installs from GitHub Releases or runs from the monorepo. Notes and API keys stay on your machine by default.",
  },
  {
    q: "Is Heavens astrology or fortune-telling?",
    a: "No. Cast and Witness mark seasons and geometry beside Scripture — clocks and glory, not monthly prognosticators. Isaiah 47 is the product fence.",
  },
  {
    q: "Which Bible translations ship?",
    a: "Public-domain English witnesses only (KJV and listed PD packs). No NIV, ESV, or NET. Cross-references credit Open Bible (CC BY).",
  },
  {
    q: "Are hermetic texts for ritual use?",
    a: "No. Hermetic and world shelves are historical study beside the Word — credited, labeled, and never packaged as ceremony instructions.",
  },
  {
    q: "Is Anointed Staff free?",
    a: "Yes. Application source is Apache-2.0. Scripture and Extra-canon keep their own PD/CC credits — see NOTICE and Settings → About.",
  },
]

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Anointed Staff",
    url: "https://www.anointedstaff.com",
    logo: "https://www.anointedstaff.com/brand-mark.png",
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Anointed Staff",
    url: "https://www.anointedstaff.com",
    description,
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Anointed Staff",
    applicationCategory: "EducationalApplication",
    operatingSystem: "Windows, Linux, macOS",
    description,
    url: "https://www.anointedstaff.com",
    downloadUrl: releasePage,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    featureList: features.map((f) => f.title),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
]
---

<BaseLayout
  title={title}
  description={description}
  ogImage="/marketing/stills/landing/hero-lamp-desk-16x9.png"
  jsonLd={jsonLd}
>
  <section class="hero" aria-label="Anointed Staff">
    <div class="hero-media" aria-hidden="true">
      <video
        class="hero-desk hero-bed"
        src="/marketing/comfy/video/bed-lamp-desk.mp4"
        poster="/marketing/stills/landing/hero-lamp-desk-16x9.png"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
      ></video>
      <img
        class="hero-atmosphere"
        src="/marketing/stills/landing/heavens-clocks-16x9.png"
        alt=""
        width="1280"
        height="720"
      />
    </div>
    <div class="hero-copy">
      <img
        class="hero-wordmark"
        src="/brand/wordmark-clean-dark.png"
        alt="Anointed Staff"
        width="720"
        height="720"
      />
      <h1>A lamp-lit desk for the Word you keep.</h1>
      <p>
        Scripture at the center. Strong’s, Extra-canon, Heavens, Notes, Gematria, and optional AI
        open beside the chapter — on a machine that holds your notes and keys.
      </p>
      <div class="cta-row download-os" data-download-os>
        <a class="btn btn-primary" data-os="windows" href={downloads.windows.href}>Windows</a>
        <a class="btn btn-ghost" data-os="linux" href={downloads.linuxAppImage.href}>Linux AppImage</a>
        <a class="btn btn-ghost" data-os="linux" href={downloads.linuxDeb.href}>Linux .deb</a>
        <a class="btn btn-ghost" data-os="mac" href={downloads.mac.href}>macOS</a>
        <a class="btn btn-ghost" href={github}>View source</a>
      </div>
      <p class="download-note">
        Or browse all assets on <a href={releasePage}>Releases v0.2.0</a>. Unsigned macOS builds:
        right-click → Open if Gatekeeper blocks.
      </p>
    </div>
  </section>

  <section class="section reveal" id="why">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Why the desk</p>
        <h2>Most study walks scatter across tabs</h2>
        <p>
          One window for the chapter. Another for a lexicon. Another for a chart. Another for a
          notebook that never quite stays yours. Anointed Staff keeps the open chapter as the
          center of the desk and opens language, older shelves, and the sky as panes beside it —
          not as a maze of accounts.
        </p>
      </div>
    </div>
  </section>

  <section class="section muted-band reveal" id="film">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Watch</p>
        <h2>A study desk you keep</h2>
        <p>
          Twenty-five seconds of kinetic type and real panes — Scripture at the center, Hebrew and
          Strong’s beside the line, Heavens as clocks, notes that stay on your machine.
        </p>
      </div>
      <figure class="kinetic-feature">
        <video
          controls
          playsinline
          preload="metadata"
          poster="/marketing/stills/landing/hero-lamp-desk-16x9.png"
          src="/marketing/exports/kinetic-text-ad.mp4"
        ></video>
        <figcaption>
          Kinetic launch cut · 25s · 16:9 —
          <a href="/marketing/exports/kinetic-text-ad-9x16.mp4">download 9:16</a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section lore-band reveal" id="staff">
    <div class="wrap split">
      <div class="section-head">
        <p class="eyebrow">The Staff</p>
        <h2>Companion for the walk, not a relic shop</h2>
        <p>
          In the lore of this desk, the staff is what you lean on while you read: a quiet
          companion for Word, language, and sky. It is not merchandise for seals or ceremony.
          Anointing here means set-apart attention — the chapter lit, the side shelves labeled,
          the room kept local so study does not leak into someone else’s cloud.
        </p>
      </div>
      <img
        class="brand-plate"
        src="/marketing/stills/landing/staff-gold-mark-1x1.png"
        alt="Carved wooden staff in warm lamp light — companion atmosphere for Anointed Staff"
        width="1024"
        height="1024"
        loading="lazy"
      />
    </div>
  </section>

  <section class="section muted-band reveal" id="desk">
    <div class="wrap split">
      <div>
        <div class="section-head">
          <p class="eyebrow">The Desk</p>
          <h2>The chapter is the altar of the room</h2>
          <p>
            Public-domain English witnesses stay on the line — KJV and listed PD packs, never
            NIV/ESV/NET. Strong’s numbers mark the text. Optional AI packs a study packet when you
            ask; keys default to session-only. Your notes live in this device’s profile.
          </p>
        </div>
        <div class="cta-row">
          <a class="btn btn-ghost" href="#catalog">See what’s on the desk</a>
          <a class="btn btn-ghost" href="/blog">Read the desk notes</a>
        </div>
      </div>
      <img
        src="/screenshots/desk-strongs.png"
        alt="Strong’s pane open beside Matthew on the Anointed Staff desk"
        width="1600"
        height="1000"
        loading="lazy"
      />
    </div>
  </section>

  <section class="section reveal" id="catalog">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">On the desk</p>
        <h2>What you can open beside the chapter</h2>
        <p>
          Not every control — the ones that make the desk a whole room for Word, language, sky,
          and notes.
        </p>
      </div>
      <div class="feature-catalog">
        {
          features.map((f) => (
            <article>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section muted-band reveal" id="gallery">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Look inside</p>
        <h2>Real panes from the running desk</h2>
        <p>Heavens, Extra-canon, Notes, Gematria, Strong’s, and AI — screenshots, not mockups.</p>
      </div>
      <div class="shot-grid">
        <figure>
          <img
            src="/screenshots/desk-heavens-wheel.png"
            alt="Heavens Cast wheel with Witness path beside Scripture"
            width="1600"
            height="1000"
            loading="lazy"
          />
          <figcaption>Heavens — Cast wheel and Witness beside the chapter</figcaption>
        </figure>
        <figure>
          <img
            src="/screenshots/desk-extra-canon.png"
            alt="Extra-canon shelf with public-domain gospel sayings"
            width="1600"
            height="1000"
            loading="lazy"
          />
          <figcaption>Extra-canon — PD shelf outside the sixty-six</figcaption>
        </figure>
        <figure>
          <img
            src="/screenshots/desk-notes-kanban.png"
            alt="Notes Kanban with verse cards from To study to Applied"
            width="1600"
            height="1000"
            loading="lazy"
          />
          <figcaption>Notes — Kanban lanes for verse cards</figcaption>
        </figure>
        <figure>
          <img
            src="/screenshots/desk-gematria.png"
            alt="Gematria letter study for Aleph with Hear and drills"
            width="1600"
            height="1000"
            loading="lazy"
          />
          <figcaption>Gematria — letters, counts, and Hear</figcaption>
        </figure>
        <figure>
          <img
            src="/screenshots/desk-ai-chat.png"
            alt="AI chat explaining a chapter with local Ollama settings"
            width="1600"
            height="1000"
            loading="lazy"
          />
          <figcaption>AI — optional local model beside the chapter</figcaption>
        </figure>
        <figure>
          <img
            src="/screenshots/desk-heavens-cast.png"
            alt="Heavens cast form with study tools and Books pane"
            width="1600"
            height="1000"
            loading="lazy"
          />
          <figcaption>Cast form — stations, Witness, Decans, and more</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section reveal" id="features">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Three deeper rooms</p>
        <h2>Shelf, sky, and quiet practice</h2>
        <p>
          Longer walks through Extra-canon rights, Heavens clocks-not-fortunes, and offline
          Practice.
        </p>
      </div>
      <div class="feature-grid">
        <a class="feature-link" href="/blog/extra-canon-public-domain-shelf">
          <img
            src="/brand/feature-shelf.png"
            alt="Parchment shelf atmosphere for Extra-canon study"
            width="1024"
            height="1024"
            loading="lazy"
          />
          <h3>Extra-canon PD shelf</h3>
          <p>
            Older books beside the sixty-six — credited, labeled, never smuggled as Scripture.
          </p>
        </a>
        <a class="feature-link" href="/blog/heavens-clocks-not-fortunes">
          <img
            src="/brand/feature-heavens.png"
            alt="Lamp-night sky wash for Heavens clocks and glory"
            width="1024"
            height="1024"
            loading="lazy"
          />
          <h3>Heavens: clocks, not fortunes</h3>
          <p>
            Cast and Witness mark seasons and geometry beside the open chapter. Isaiah 47 keeps
            the fence.
          </p>
        </a>
        <a class="feature-link" href="/blog/offline-practice-quiet-desk">
          <img
            src="/brand/feature-practice.png"
            alt="Notebook with a single drop of oil — quiet Practice on the desk"
            width="1024"
            height="1024"
            loading="lazy"
          />
          <h3>Letters · Practice · quiet desk</h3>
          <p>
            Hear clips, drills, Temple walk, and Quiet music — stillness that stays offline.
          </p>
        </a>
      </div>
    </div>
  </section>

  <section class="section lore-band reveal" id="fence">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">The Fence</p>
        <h2>What the desk will not become</h2>
        <p>
          Lore without a fence turns into marketing fog. These lines stay visible on the product
          and on this page.
        </p>
      </div>
      <ul class="fence-list">
        <li>
          <strong>Clocks, not fortunes</strong>
          <span>
            Heavens will not sell monthly prognosticators. Aspects are geometry on the wheel —
            tension or ease in old tables — not a ruling over a life.
          </span>
        </li>
        <li>
          <strong>Public-domain honesty</strong>
          <span>
            Extra-canon titles ship only when English rights clear. Brill wrappers and sacred-name
            “restored” editions without a PD dedication stay out.
          </span>
        </li>
        <li>
          <strong>Historical shelves, not ritual kits</strong>
          <span>
            Hermetic and world canons are study texts with credits. The desk will not teach seals
            or ceremony.
          </span>
        </li>
        <li>
          <strong>Local by default</strong>
          <span>
            Practice audio is offline. Leave-device confirms cover place search, web search, and
            cloud model tests. Session-only keys are the default.
          </span>
        </li>
      </ul>
    </div>
  </section>

  <section class="section muted-band reveal" id="appearances">
    <div class="wrap split">
      <img
        src="/screenshots/desk-notes-kanban.png"
        alt="Notes Kanban on the Anointed Staff desk"
        width="1600"
        height="1000"
        loading="lazy"
      />
      <div>
        <div class="section-head">
          <p class="eyebrow">Appearances</p>
          <h2>Five rooms, one Staff Gold</h2>
          <p>
            Light, Dark, Mystic, Parchment, and Ink share the same gold voltage and type stack —
            Outfit for chrome, Fraunces for titles, Literata for Scripture, Noto for Hebrew and
            Greek. Pick the lamp that matches the hour.
          </p>
        </div>
        <div class="theme-strip" aria-label="Desk appearances">
          <span class="theme-chip">Light</span>
          <span class="theme-chip">Dark</span>
          <span class="theme-chip">Mystic</span>
          <span class="theme-chip">Parchment</span>
          <span class="theme-chip">Ink</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section reveal" id="faq">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Questions</p>
        <h2>Before you download</h2>
        <p>Plain answers to the objections that usually stop a careful reader.</p>
      </div>
      <div class="faq">
        {
          faqItems.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section download-band reveal" id="download">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Keep the desk</p>
        <h2>Run Anointed Staff on your machine</h2>
        <p>
          Pick your OS installer below, or clone the monorepo and run locally. This site does not
          host the study runtime — that is intentional.
        </p>
      </div>
      <div class="os-download-grid" data-download-os>
        <a class="os-card" data-os="windows" href={downloads.windows.href}>
          <strong>Windows</strong>
          <span>{downloads.windows.filename}</span>
        </a>
        <a class="os-card" data-os="linux" href={downloads.linuxAppImage.href}>
          <strong>Linux AppImage</strong>
          <span>{downloads.linuxAppImage.filename}</span>
        </a>
        <a class="os-card" data-os="linux" href={downloads.linuxDeb.href}>
          <strong>Linux .deb</strong>
          <span>{downloads.linuxDeb.filename}</span>
        </a>
        <a class="os-card" data-os="mac" href={downloads.mac.href}>
          <strong>macOS (Apple Silicon)</strong>
          <span>{downloads.mac.filename}</span>
        </a>
      </div>
      <div class="cta-row">
        <a class="btn btn-ghost" href={releasePage}>All release assets</a>
        <a class="btn btn-ghost" href={github}>View source</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const ua = navigator.userAgent.toLowerCase()
  let os: "windows" | "mac" | "linux" = "windows"
  if (ua.includes("mac")) os = "mac"
  else if (ua.includes("linux")) os = "linux"
  for (const root of document.querySelectorAll("[data-download-os]")) {
    root.querySelectorAll("[data-os]").forEach((el) => {
      if (el.getAttribute("data-os") === os) el.setAttribute("data-preferred", "true")
    })
  }
</script>
