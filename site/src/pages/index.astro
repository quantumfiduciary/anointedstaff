---
import BaseLayout from "../layouts/BaseLayout.astro"
import { Hero } from "../components/landing/Hero"
import { BrandStrip } from "../components/landing/BrandStrip"
import { FilmStage } from "../components/landing/FilmStage"
import { FeatureBento } from "../components/landing/FeatureBento"
import { FenceList } from "../components/landing/FenceList"
import { FaqAccordion } from "../components/landing/FaqAccordion"
import { HebrewPlate } from "../components/landing/HebrewPlate"
import { PromiseBand } from "../components/landing/PromiseBand"
import { DownloadOs } from "../components/landing/DownloadOs"
import { Reveal } from "../components/landing/Reveal"
import { downloads, github, releasePage } from "../data/downloads"

const title = "Anointed Staff — Local Scripture Study Desk"
const description =
  "One local desk that gathers public-domain Scripture, Extra-canon shelves, Strong’s, letters, Heavens clocks, Notes, Practice, and optional AI beside the open chapter—notes and keys stay on your machine."

const features = [
  {
    icon: "book-open",
    title: "Bible · Books",
    body: "Public-domain witnesses on the rail. The chapter stays the altar while Books and search move you through the canon without leaving the room.",
  },
  {
    icon: "hash",
    title: "Strong’s",
    body: "Look up a number, walk This verse, Paleo notes, Hear, and Ask about this word — lexicon light beside the open line, not a separate tab.",
  },
  {
    icon: "sparkles",
    title: "AI beside the chapter",
    body: "A study companion that packs Explain, Strong’s, Extra-canon, and Heavens chips around the verse you already have open. Optional local or cloud model; session-only keys by default — ingenuity that serves the Word without leasing your desk.",
    featured: true,
  },
  {
    icon: "library",
    title: "Extra-canon shelf",
    body: "Public-domain books beside the sixty-six — Enoch, Sophia, Gospels.net, Fathers, Hermetic history — credited, labeled, and never smuggled as Scripture.",
  },
  {
    icon: "git-branch",
    title: "Roots",
    body: "Strong’s chains, Hitchcock names, and English trees so language study stays next to the chapter you are reading.",
  },
  {
    icon: "kanban",
    title: "Notes · Wiki · Kanban",
    body: "Highlights, journals, wiki pages, and Kanban lanes from To study to Applied — your growth stays on this device.",
  },
  {
    icon: "alphabet-hebrew",
    title: "Gematria · letters",
    body: "Learn the alef-bet, mothers/doubles/simples, count a word, Hear clips, and drills that send you back into Scripture.",
  },
  {
    icon: "orbit",
    title: "Heavens",
    body: "Cast a chart, Witness path, Decans, Circle, Camp, Job 38, Psalm 19 — clocks and glory beside Scripture, not fortunes.",
  },
  {
    icon: "flower-2",
    title: "Practice",
    body: "Temple walk, Drill, Cards, Meditate, Quiet music, and offline Hebrew Hear — stillness baked into the build so growth is not noise.",
  },
  {
    icon: "mic",
    title: "Voice",
    body: "Hands-free study window and chapter Listen with voices installed on your machine.",
  },
  {
    icon: "audio-lines",
    title: "Compare · Listen",
    body: "Second PD witnesses (including non-English packs) and read-aloud for the open chapter.",
  },
  {
    icon: "palette",
    title: "Five appearances",
    body: "Light, Dark, Mystic, Parchment, and Ink share Staff Gold — one voltage across five rooms for the hour you study.",
  },
]

const fenceItems = [
  {
    icon: "clock",
    title: "Clocks, not fortunes",
    body: "Heavens will not sell monthly prognosticators. Aspects are geometry on the wheel — tension or ease in old tables — not a ruling over a life.",
  },
  {
    icon: "scroll-text",
    title: "Public-domain honesty",
    body: "Extra-canon titles ship only when English rights clear. Brill wrappers and sacred-name “restored” editions without a PD dedication stay out.",
  },
  {
    icon: "book-marked",
    title: "Historical shelves, not ritual kits",
    body: "Hermetic and world canons are study texts with credits. The desk will not teach seals or ceremony.",
  },
  {
    icon: "lock",
    title: "Local by default",
    body: "Practice audio is offline. Leave-device confirms cover place search, web search, and cloud model tests. Session-only keys are the default.",
  },
]

const faqItems = [
  {
    q: "Is this a cloud Bible app?",
    a: "No. Anointed Staff is local-first. The marketing site educates; the study runtime installs from GitHub Releases or runs from the monorepo. Notes and API keys stay on your machine by default.",
  },
  {
    q: "Is Heavens astrology or fortune-telling?",
    a: "No. Cast and Witness mark seasons and geometry beside Scripture — clocks and glory, not monthly prognosticators. Isaiah 47 is the product fence.",
  },
  {
    q: "Which Bible translations ship?",
    a: "Public-domain English witnesses only (KJV and listed PD packs). No NIV, ESV, or NET. Cross-references credit Open Bible (CC BY).",
  },
  {
    q: "Are hermetic texts for ritual use?",
    a: "No. Hermetic and world shelves are historical study beside the Word — credited, labeled, and never packaged as ceremony instructions.",
  },
  {
    q: "Is Anointed Staff free?",
    a: "Yes. Application source is Apache-2.0. Scripture and Extra-canon keep their own PD/CC credits — see NOTICE and Settings → About.",
  },
]

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Anointed Staff",
    url: "https://www.anointedstaff.com",
    logo: "https://www.anointedstaff.com/brand/icons/icon-192.png",
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Anointed Staff",
    url: "https://www.anointedstaff.com",
    description,
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Anointed Staff",
    applicationCategory: "EducationalApplication",
    operatingSystem: "Windows, Linux, macOS",
    description,
    url: "https://www.anointedstaff.com",
    downloadUrl: releasePage,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    featureList: features.map((f) => f.title),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
]
---

<BaseLayout
  title={title}
  description={description}
  ogImage="/marketing/stills/landing/hero-lamp-desk-16x9.png"
  jsonLd={jsonLd}
>
  <Hero
    client:load
    windowsHref={downloads.windows.href}
    linuxHref={downloads.linuxAppImage.href}
    macHref={downloads.mac.href}
    githubHref={github}
    releasePage={releasePage}
  />

  <BrandStrip client:visible />

  <section class="section" id="why">
    <div class="wrap">
      <Reveal client:visible>
        <div class="section-head max-w-2xl">
          <p class="eyebrow">Why the desk</p>
          <h2>This kind of room almost never exists in one place</h2>
          <p>
            Most study walks scatter: a Bible tab, a lexicon site, a chart elsewhere, a notebook that
            never quite stays yours. Anointed Staff gathers ancient witnesses and the tools that
            serve them — Strong’s, letters, Extra-canon shelves, Heavens clocks, Notes, Practice,
            and optional AI — into one lamp-lit desk with the chapter at the center. Local, not
            leased. Glory with a fence.
          </p>
        </div>
      </Reveal>
    </div>
  </section>

  <PromiseBand client:visible />

  <FilmStage client:visible />

  <section class="section lore-band" id="staff">
    <div class="wrap split">
      <Reveal client:visible>
        <div class="section-head">
          <p class="eyebrow">The Staff</p>
          <h2>Companion for the walk, not a relic shop</h2>
          <p>
            In the lore of this desk, the staff is what you lean on while you read: a quiet
            companion for Word, language, and sky. Anointing here means set-apart attention — the
            chapter lit, the side shelves labeled, the room kept local so study does not leak into
            someone else’s cloud. Ingenuity in service of Scripture, not spectacle.
          </p>
        </div>
      </Reveal>
      <img
        class="brand-plate"
        src="/brand/mark-as-dark.png"
        alt="Anointed Staff mark — gold crook between A and S on charcoal"
        width={1024}
        height={1024}
        loading="lazy"
      />
    </div>
  </section>

  <section class="section muted-band" id="desk">
    <div class="wrap split">
      <div>
        <Reveal client:visible>
          <div class="section-head">
            <p class="eyebrow">The Desk</p>
            <h2>The chapter is the altar of the room</h2>
            <p>
              Public-domain English witnesses stay on the line — KJV and listed PD packs, never
              NIV/ESV/NET. Strong’s marks the text. Older shelves open beside it. When you ask, AI
              packs a study packet around the verse you already see — keys session-only by default.
              Your notes live in this device’s profile so growth stays yours.
            </p>
          </div>
          <div class="cta-row">
            <a class="btn btn-ghost" href="#catalog">See what’s on the desk</a>
            <a class="btn btn-ghost" href="/blog">Read the desk notes</a>
          </div>
        </Reveal>
      </div>
      <img
        src="/screenshots/desk-strongs.png"
        alt="Strong’s pane open beside Matthew on the Anointed Staff desk"
        width="1600"
        height="1000"
        loading="lazy"
      />
    </div>
  </section>

  <FeatureBento client:visible features={features} />

  <HebrewPlate client:visible />

  <section class="section" id="gallery">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Look inside</p>
        <h2>Proof of the room, not mockups</h2>
        <p>
          Heavens, Extra-canon, Notes, Gematria, Strong’s, and AI — the same desk you download.
        </p>
      </div>
      <div class="shot-grid">
        <figure>
          <img
            src="/screenshots/desk-heavens-wheel.png"
            alt="Heavens Cast wheel with Witness path beside Scripture"
            width="1600"
            height="1000"
            loading="lazy"
          />
          <figcaption>Heavens — Cast wheel and Witness beside the chapter</figcaption>
        </figure>
        <figure>
          <img
            src="/screenshots/desk-extra-canon.png"
            alt="Extra-canon shelf with public-domain gospel sayings"
            width="1600"
            height="1000"
            loading="lazy"
          />
          <figcaption>Extra-canon — PD shelf outside the sixty-six</figcaption>
        </figure>
        <figure>
          <img
            src="/screenshots/desk-notes-kanban.png"
            alt="Notes Kanban with verse cards from To study to Applied"
            width="1600"
            height="1000"
            loading="lazy"
          />
          <figcaption>Notes — Kanban lanes for verse cards</figcaption>
        </figure>
        <figure>
          <img
            src="/screenshots/desk-gematria.png"
            alt="Gematria letter study for Aleph with Hear and drills"
            width="1600"
            height="1000"
            loading="lazy"
          />
          <figcaption>Gematria — letters, counts, and Hear</figcaption>
        </figure>
        <figure>
          <img
            src="/screenshots/desk-ai-chat.png"
            alt="AI chat explaining a chapter with local Ollama settings"
            width="1600"
            height="1000"
            loading="lazy"
          />
          <figcaption>AI — optional local model beside the chapter</figcaption>
        </figure>
        <figure>
          <img
            src="/screenshots/desk-heavens-cast.png"
            alt="Heavens cast form with study tools and Books pane"
            width="1600"
            height="1000"
            loading="lazy"
          />
          <figcaption>Cast form — stations, Witness, Decans, and more</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section muted-band" id="features">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Three deeper rooms</p>
        <h2>Shelf, sky, and quiet practice</h2>
        <p>
          Walk older texts honestly, read the heavens as clocks beside glory, and grow in stillness
          that never needs a subscription.
        </p>
      </div>
      <div class="feature-grid">
        <a class="feature-link" href="/blog/extra-canon-public-domain-shelf">
          <img
            src="/brand/feature-shelf.png"
            alt="Parchment shelf atmosphere for Extra-canon study"
            width="1024"
            height="1024"
            loading="lazy"
          />
          <h3>Extra-canon PD shelf</h3>
          <p>
            Ancient shelves beside the sixty-six — credited, labeled, never smuggled as Scripture.
            History in reach of the chapter.
          </p>
        </a>
        <a class="feature-link" href="/blog/heavens-clocks-not-fortunes">
          <img
            src="/brand/feature-heavens.png"
            alt="Lamp-night sky wash for Heavens clocks and glory"
            width="1024"
            height="1024"
            loading="lazy"
          />
          <h3>Heavens: clocks, not fortunes</h3>
          <p>
            Cast and Witness mark seasons and geometry beside the open chapter — mystical glory with
            Isaiah 47 as the fence.
          </p>
        </a>
        <a class="feature-link" href="/blog/offline-practice-quiet-desk">
          <img
            src="/brand/feature-practice.png"
            alt="Notebook with a single drop of oil — quiet Practice on the desk"
            width="1024"
            height="1024"
            loading="lazy"
          />
          <h3>Letters · Practice · quiet desk</h3>
          <p>
            Hear clips, drills, Temple walk, and Quiet music — grow offline in the same room as the
            Word.
          </p>
        </a>
      </div>
    </div>
  </section>

  <FenceList client:visible items={fenceItems} />

  <section class="section muted-band" id="appearances">
    <div class="wrap split">
      <img
        src="/screenshots/desk-notes-kanban.png"
        alt="Notes Kanban on the Anointed Staff desk"
        width="1600"
        height="1000"
        loading="lazy"
      />
      <div>
        <div class="section-head">
          <p class="eyebrow">Appearances</p>
          <h2>Five rooms, one Staff Gold</h2>
          <p>
            Light, Dark, Mystic, Parchment, and Ink share the same gold voltage and type stack —
            Outfit for chrome, Fraunces for titles, Literata for Scripture, Noto for Hebrew and
            Greek. Pick the lamp that matches the hour.
          </p>
        </div>
        <div class="theme-strip" aria-label="Desk appearances">
          <span class="theme-chip">Light</span>
          <span class="theme-chip">Dark</span>
          <span class="theme-chip">Mystic</span>
          <span class="theme-chip">Parchment</span>
          <span class="theme-chip">Ink</span>
        </div>
      </div>
    </div>
  </section>

  <FaqAccordion client:visible items={faqItems} />

  <DownloadOs
    client:visible
    windowsHref={downloads.windows.href}
    linuxHref={downloads.linuxAppImage.href}
    linuxDebHref={downloads.linuxDeb.href}
    macHref={downloads.mac.href}
    githubHref={github}
    releasePage={releasePage}
  />
</BaseLayout>
